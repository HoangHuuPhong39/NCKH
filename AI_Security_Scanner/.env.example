# ==============================================================================
# AI Security Scanner & Guard Proxy - Example Environment Configuration
# ==============================================================================
# Copy this file to `.env` inside `AI_Security_Scanner/` and fill in your values.
# Never commit your real `.env` file to version control.
# ==============================================================================

# --- Target LLM / Judge Configuration ---
SCANNER_TARGET_URL=http://localhost:11434
SCANNER_TARGET_MODEL=llama3
SCANNER_JUDGE_MODEL=qwen2.5
SCANNER_PROVIDER=auto                 # auto | ollama | openai
SCANNER_API_KEY=                      # Optional: OpenAI / OpenAI-compatible Bearer key
SCANNER_TIMEOUT=90
SCANNER_MAX_RETRIES=1

# --- Web Dashboard & Authentication ---
WEB_HOST=127.0.0.1
WEB_PORT=5000
SCANNER_REQUIRE_AUTH=false            # Set to true in shared / production / Docker deployments
SCANNER_STRICT_SECRETS=false          # Set to true to fail-fast if JWT/Admin secrets are unset
SCANNER_JWT_SECRET=change-me-to-a-random-32-char-secret
SCANNER_ADMIN_API_KEY=change-me-to-a-strong-admin-api-key
SCANNER_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- Storage, Logging & Path Confinement ---
DATABASE_PATH=data/scanner.db
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR | CRITICAL
SCANNER_ALLOWED_SCAN_ROOTS=           # Optional OS path-separated list of extra local scan roots

# --- Hardened AI Guard Proxy v3.1 (guard_proxy/app.py) ---
OLLAMA_BACKEND=http://127.0.0.1:11434
ALLOWED_MODELS=llama3-secure
DEFAULT_MODEL=llama3-secure
GUARD_API_KEY=                        # Required if binding Guard Proxy to a non-loopback host
GUARD_CANARY=                         # Optional custom canary token matching Modelfile
HOST=127.0.0.1
PORT=8000
TRUST_PROXY=0                         # Set to 1 only behind a trusted reverse proxy
AUDIT_LOG_PATH=logs/guard_audit.jsonl
